<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Goatty.MainWindow"
        Title="Goatty"
        Width="1000"
        Height="700"
        MinWidth="480"
        MinHeight="320"
        Background="{DynamicResource TerminalBackgroundBrush}">
  <Grid RowDefinitions="Auto,*">
    <Border x:Name="GroupBar" IsVisible="False" Background="{DynamicResource TabBarBrush}"
            BorderBrush="{DynamicResource TabBarBorderBrush}" BorderThickness="0,0,0,1">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <TabStrip x:Name="GroupTabs" />
      </ScrollViewer>
    </Border>
    <Grid x:Name="GroupContent" Grid.Row="1" />
  </Grid>
</Window>
