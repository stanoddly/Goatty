<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Goatty.MainWindow"
        Title="Goatty"
        Width="1000"
        Height="700"
        MinWidth="480"
        MinHeight="320"
        WindowDecorations="None"
        Background="{DynamicResource TerminalBackgroundBrush}">
  <Panel>
    <Grid RowDefinitions="Auto,*">
      <Border x:Name="GroupBar" IsVisible="False">
        <Panel x:Name="GroupBarContent">
          <ScrollViewer Classes="tab-scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <TabStrip x:Name="GroupTabs" />
          </ScrollViewer>
        </Panel>
      </Border>
      <Grid x:Name="GroupContent" Grid.Row="1" />
    </Grid>
    <Panel x:Name="WindowControlsHost" HorizontalAlignment="Right" VerticalAlignment="Top" />
  </Panel>
</Window>
