<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Goatty.MainWindow"
        Title="Goatty"
        Width="1000"
        Height="700"
        MinWidth="480"
        MinHeight="320"
        Background="#2E3440"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border x:Name="TitleBar" Background="#3B4252">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="MinimizeButton" Classes="caption" ToolTip.Tip="Minimize">
            <Path Data="M 0,5.5 H 11" Stroke="#D8DEE9" StrokeThickness="1" />
          </Button>
          <Button x:Name="MaximizeButton" Classes="caption" ToolTip.Tip="Maximize">
            <Path x:Name="MaximizeIcon" Data="M 0.5,0.5 H 10.5 V 10.5 H 0.5 Z" Stroke="#D8DEE9" StrokeThickness="1" />
          </Button>
          <Button x:Name="CloseButton" Classes="caption close" ToolTip.Tip="Close">
            <Path Data="M 0.5,0.5 L 10.5,10.5 M 10.5,0.5 L 0.5,10.5" Stroke="#D8DEE9" StrokeThickness="1" />
          </Button>
        </StackPanel>
        <Border x:Name="DragArea" DockPanel.Dock="Right" Width="120" Background="Transparent" />
        <Grid x:Name="TerminalBarHost" />
      </DockPanel>
    </Border>
    <Border x:Name="GroupBar" Grid.Row="1" IsVisible="False" Background="#3B4252" Padding="4,2">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="GroupHeaders" Orientation="Horizontal" Spacing="3" />
      </ScrollViewer>
    </Border>
    <Grid x:Name="GroupContent" Grid.Row="2" />
  </Grid>
</Window>
